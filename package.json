{
  "name": "dsh-model-team",
  "version": "0.4.2",
  "description": "会话级模型路由插件：dsh 里只注册一个虚拟模型，真实模型按会话映射转发（合法接入优先，配置型驱动）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "model-router",
    "openai-compatible",
    "deepseek"
  ],
  "homepage": "https://github.com/EIGHTfs/dsh-model-team#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/dsh-model-team.git"
  },
  "bugs": {
    "url": "https://github.com/EIGHTfs/dsh-model-team/issues"
  },
  "author": "EIGHTfs",
  "type": "module",
  "main": "./src/plugin/index.js",
  "exports": {
    ".": "./src/plugin/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "src",
    "lib/client.js",
    "lib/shared",
    "config",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.cjs",
    "build:client": "node build.cjs",
    "build:theme": "node scripts/build-theme.mjs",
    "mock:server": "node scripts/mock-team-server.mjs",
    "gate:ui-contract": "node scripts/check-ui-contract.mjs",
    "prepack": "node build.cjs",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke-capabilities.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild-wasm": "^0.28.2"
  }
}
